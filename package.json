{
  "name": "speclock2",
  "version": "1.0.0",
  "private": true,
  "description": "pi agent router monorepo: agentd (scheduler daemon), backend (HTTP gateway), web (dashboard).",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "npm test -w @speclock/agentd",
    "daemon": "npm run daemon -w @speclock/agentd",
    "daemon:stop": "npm run daemon:stop -w @speclock/agentd",
    "backend": "npm start -w @speclock/backend",
    "web": "npm run dev -w @speclock/web"
  }
}

{
  "name": "@speclock/agentd",
  "version": "1.0.0",
  "private": true,
  "description": "Resident multi-agent scheduler for pi: agentd daemon + pi extension, driven over ACP.",
  "type": "module",
  "scripts": {
    "daemon": "node daemon/agentd.mjs",
    "daemon:stop": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\"Name='node.exe'\\\" | Where-Object { $_.CommandLine -like '*agentd.mjs*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }\"",
    "daemon:log": "powershell -NoProfile -Command \"Get-Content -Wait -Tail 40 data/agentd.log\"",
    "test": "npm run test:daemon && npm run test:events && npm run test:switch && npm run test:models && npm run test:health && npm run test:stream && npm run test:cwd && npm run test:models-json && npm run test:instances && npm run test:transcript && npm run test:dispatcher && npm run test:projects && npm run test:start && npm run test:idle && npm run test:forced && npm run test:interrupted && npm run test:reply && npm run test:tasks && npm run test:handoff-prompts && npm run test:queue && npm run test:prompt-queue && npm run test:run-tracker && npm run test:transport && npm run test:dispatcher-queue && npm run test:pi-rpc && npm run test:compaction && npm run test:dispatcher-compact && npm run test:pieces && npm run test:rules && npm run test:templates",
    "test:daemon": "node tools/daemon-share-test.mjs dsh",
    "test:switch": "node tools/session-switch-test.mjs dsh",
    "test:models": "node tools/model-persist-test.mjs dsh",
    "test:stream": "node tools/stream-test.mjs pi",
    "bench": "node tools/bench-switch.mjs mcode",
    "test:health": "node tools/health-test.mjs dsh",
    "test:cwd": "node tools/cwd-test.mjs",
    "test:events": "node tools/events-test.mjs dsh",
    "test:models-json": "node tools/pi-models-test.mjs",
    "test:instances": "node tools/instances-test.mjs dsh",
    "test:transcript": "node tools/transcript-test.mjs dsh",
    "test:dispatcher": "node tools/dispatcher-test.mjs",
    "test:projects": "node tools/projects-test.mjs dsh",
    "test:start": "node tools/start-retry-test.mjs",
    "test:idle": "node tools/idle-timeout-test.mjs",
    "test:forced": "node tools/forced-stop-test.mjs",
    "test:interrupted": "node tools/interrupted-test.mjs",
    "test:reply": "node tools/reply-test.mjs",
    "test:tasks": "node tools/tasks-test.mjs",
    "test:handoff-prompts": "node tools/handoff-prompts-test.mjs",
    "test:queue": "node tools/queue-test.mjs",
    "test:prompt-queue": "node tools/prompt-queue-test.mjs",
    "test:run-tracker": "node tools/run-tracker-test.mjs",
    "test:transport": "node tools/acp-transport-test.mjs",
    "test:dispatcher-queue": "node tools/dispatcher-queue-test.mjs",
    "test:pi-rpc": "node tools/pi-rpc-test.mjs",
    "test:pi-cancel": "node tools/pi-cancel-test.mjs",
    "test:compaction": "node tools/compaction-test.mjs",
    "test:dispatcher-compact": "node tools/dispatcher-compact-test.mjs",
    "test:pieces": "node tools/pieces-test.mjs",
    "test:rules": "node tools/rules-test.mjs",
    "test:templates": "node tools/templates-test.mjs"
  }
}

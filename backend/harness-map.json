{
  "watchdog_minutes_default": 60,
  "masters": {
    "backend": "pi",
    "frontend": "pi"
  },
  "harnesses": {
    "sl2-fake": {
      "command": "D:\\Project2\\code-261013-speclock2\\speclock2\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "D:\\Project2\\code-261013-speclock2\\speclock2\\backend\\scripts\\fake_harness.py"
      ],
      "prompt_mode": "arg",
      "note": "被派发 harness 替身：无 key 自测用；主代理默认走 pi，本条仅兜底"
    },
    "pi": {
      "command": "D:\\Environment\\nodejs\\node.EXE",
      "args": [
        "D:\\Environment\\nodejs\\node_modules\\@earendil-works\\pi-coding-agent\\dist\\bundle\\cli.js",
        "--mode",
        "json",
        "-p",
        "{prompt}",
        "--no-session",
        "--model",
        "minimax-cn/MiniMax-M3"
      ],
      "prompt_mode": "inline"
    },
    "claude-code": {
      "command": "claude",
      "args": [
        "-p",
        "{prompt}",
        "--output-format",
        "stream-json",
        "--verbose"
      ],
      "prompt_mode": "inline"
    },
    "codex": {
      "command": "codex",
      "args": [
        "exec",
        "--json",
        "{prompt}"
      ],
      "prompt_mode": "inline"
    }
  }
}
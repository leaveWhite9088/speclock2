{
  "name": "speclock2",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "speclock2",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@speclock/agentd": {
      "resolved": "packages/agentd",
      "link": true
    },
    "node_modules/@speclock/backend": {
      "resolved": "packages/backend",
      "link": true
    },
    "node_modules/@speclock/web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/agentd": {
      "name": "@speclock/agentd",
      "version": "1.0.0"
    },
    "packages/backend": {
      "name": "@speclock/backend",
      "version": "1.0.0",
      "dependencies": {
        "@speclock/agentd": "*"
      }
    },
    "packages/web": {
      "name": "@speclock/web",
      "version": "1.0.0"
    }
  }
}
